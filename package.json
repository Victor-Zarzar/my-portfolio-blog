    "rate-limiter-flexible": "^11.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "redis": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
